{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "cursor_subagents": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "cursor-subagents",
        "mcp"
      ],
      "enabled": true,
      "timeout": 10000
    }
  },
  "permission": {
    "skill": {
      "cursor-subagents": "allow"
    },
    "cursor_subagents_*": "allow"
  }
}
