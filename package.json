{
  "name": "cursor-subagents-repo",
  "version": "0.1.0",
  "private": true,
  "description": "Portable Cursor Agent subagents for Codex, Claude Code, OpenCode, Pi, and Agent Skills harnesses.",
  "type": "module",
  "keywords": [
    "pi-package",
    "agent-skills",
    "cursor",
    "subagents",
    "mcp",
    "acp"
  ],
  "bin": {
    "cursor-subagents": "./packages/cursor-subagents/bin/cursor-subagents.mjs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/RealSid08/cursor-subagents.git"
  },
  "license": "MIT",
  "workspaces": [
    "packages/*"
  ],
  "pi": {
    "extensions": [
      "packages/pi-cursor-subagents/extensions"
    ],
    "skills": [
      "skills/cursor-subagents"
    ]
  },
  "scripts": {
    "validate": "node scripts/validate-distribution.mjs",
    "runtime:help": "node packages/cursor-subagents/bin/cursor-subagents.mjs --help",
    "runtime:doctor": "node packages/cursor-subagents/bin/cursor-subagents.mjs doctor --json",
    "runtime:models": "node packages/cursor-subagents/bin/cursor-subagents.mjs models --json",
    "pack:dry-run": "npm pack ./packages/cursor-subagents --dry-run && npm pack ./packages/opencode-cursor-subagents --dry-run && npm pack ./packages/pi-cursor-subagents --dry-run"
  }
}
